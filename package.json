{
  "name": "ahdnative",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "verify": "npm run build && npm test",
    "test": "vitest run --config vitest.config.ts",
    "test:engine": "npm run test:ci --workspace @ahdclient/engine",
    "test:content": "npm run test --workspace @ahdclient/content",
    "typecheck:engine": "npm run typecheck --workspace @ahdclient/engine",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@ahdclient/engine": "*",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "@playwright/test": "^1.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "vite": "$vite"
  }
}
