{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Trusted local application window; may enter multiplayer through Rust",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-save-game",
    "allow-load-game",
    "allow-list-saves",
    "allow-delete-save",
    "allow-open-mp-sign-in",
    "allow-open-external-destination",
    "allow-mp-view-fetch",
    "allow-mp-session-fetch",
    "allow-mp-session-mutate",
    "allow-open-ask-window",
    "allow-ask-api",
    "allow-ask-send",
    "allow-ask-stop",
    "allow-open-ask-link"
  ]
}
